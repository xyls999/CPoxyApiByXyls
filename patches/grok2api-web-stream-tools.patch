+func TestToolStreamSieveBuffersToolCallAcrossSeveralDeltas(t *testing.T) {
+	const xml = `<tool_calls><tool_call><tool_name>exec_command</tool_name><parameters>{"cmd":"Get-Content proof.txt"}</parameters></tool_call></tool_calls>`
+	for _, chunkSize := range []int{1, 7, 23} {
+		sieve := newToolStreamSieve(map[string]struct{}{"exec_command": {}})
+		var visible strings.Builder
+		var calls []parsedToolCall
+		for start := 0; start < len(xml); start += chunkSize {
+			end := min(start+chunkSize, len(xml))
+			result := sieve.Feed(xml[start:end])
+			visible.WriteString(result.SafeText)
+			calls = append(calls, result.Calls...)
+		}
+		last := sieve.Flush()
+		visible.WriteString(last.SafeText)
+		calls = append(calls, last.Calls...)
+		if len(calls) != 1 || calls[0].Name != "exec_command" || calls[0].Arguments != `{"cmd":"Get-Content proof.txt"}` || visible.Len() != 0 {
+			t.Fatalf("chunk size %d: calls=%d visible XML=%t", chunkSize, len(calls), strings.Contains(visible.String(), "<tool_calls"))
+		}
+	}
+}
+
+func TestToolStreamSievePreservesTextAroundSplitCall(t *testing.T) {
+	sieve := newToolStreamSieve(map[string]struct{}{"lookup": {}})
+	first := sieve.Feed("before <tool_ca")
+	second := sieve.Feed(`lls><tool_call><tool_name>lookup</tool_name><parameters>{"q":"x"}</parameters></tool_call></tool_calls> after`)
+	if first.SafeText != "before " || len(second.Calls) != 1 || second.SafeText != "" || second.TrailingText != " after" {
+		t.Fatalf("split tool call should preserve ordered safe text on either side: first=%q calls=%d leading=%q trailing=%q", first.SafeText, len(second.Calls), second.SafeText, second.TrailingText)
+	}
+}
+
+func TestToolStreamSieveFailsClosedOnOversizedUnterminatedXML(t *testing.T) {
+	sieve := newToolStreamSieve(map[string]struct{}{"lookup": {}})
+	first := sieve.Feed("before <tool_calls>")
+	if first.SafeText != "before " {
+		t.Fatalf("prefix = %q", first.SafeText)
+	}
+	second := sieve.Feed(strings.Repeat("x", 1<<20))
+	if second.Err != errToolStreamCaptureLimit || len(sieve.buffer) > 1<<20 || second.SafeText != "" || !sieve.done {
+		t.Fatalf("oversized tool XML was not rejected without leaking: err=%v buffered=%d safe=%d done=%t", second.Err, len(sieve.buffer), len(second.SafeText), sieve.done)
+	}
+	if flushed := sieve.Flush(); flushed.SafeText != "" {
+		t.Fatalf("oversized XML escaped during flush: length=%d", len(flushed.SafeText))
+	}
+}
